# Database Configuration
DATABASE_URL=postgresql://n8n_user:redhat@123@10.121.210.176:5432/rag_system

# ==============================================================================
# PORTKEY AUTHENTICATION OPTIONS - Choose ONE of the following setups:
# ==============================================================================

# Option 1: Provider Routing (Recommended for Azure OpenAI)
# Use this if routing to specific Azure OpenAI deployments via Portkey
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_CHAT_PROVIDER=@azure-openai-eus-global/gpt-4.1-dzs
PORTKEY_EMBEDDING_PROVIDER=@azure-openai-eus-global/text-embedding-3-large-std

# Option 2: Virtual Keys
# Uncomment these if using Portkey virtual keys instead of provider routing
# PORTKEY_API_KEY=your_portkey_api_key_here
# PORTKEY_VIRTUAL_KEY=your_portkey_virtual_key_here

# Option 3: Direct OpenAI API Key (with optional Portkey routing)
# Uncomment if you have your own OpenAI API key
# OPENAI_API_KEY=sk-your-openai-api-key-here
# PORTKEY_API_KEY=your_portkey_api_key_here  # Optional for observability
# ==============================================================================

PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Model Configuration (Azure OpenAI models)
EMBEDDING_MODEL=text-embedding-3-large-std
CHAT_MODEL=gpt-4.1-dzs
EMBEDDING_DIMENSION=3072

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000

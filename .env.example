# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragdb

# ==============================================================================
# AUTHENTICATION OPTIONS - Choose ONE of the following setups:
# ==============================================================================

# Option 1: Direct OpenAI API Key (with optional Portkey routing)
# Uncomment these if you have your own OpenAI API key
# OPENAI_API_KEY=sk-your-openai-api-key-here
# PORTKEY_API_KEY=your_portkey_api_key_here  # Optional for observability

# Option 2: Portkey Virtual Keys (Recommended if you don't have OpenAI key)
# Uncomment these if using Portkey to manage your provider keys
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_VIRTUAL_KEY=your_portkey_virtual_key_here
# ==============================================================================

PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Model Configuration
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4-turbo-preview
EMBEDDING_DIMENSION=1536

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
